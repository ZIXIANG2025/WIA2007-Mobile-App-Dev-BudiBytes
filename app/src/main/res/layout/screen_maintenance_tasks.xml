<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context="com.um.rainguard.ui.admin.MaintenanceTasksActivity"
    tools:theme="@style/AppTheme">

    <!-- Workspace Header & Disclaimer -->
    <include
        android:id="@+id/workspace_header"
        layout="@layout/include_workspace_header" />

    <ScrollView
        android:id="@+id/page_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/page_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Maintenance Tasks"
                android:textColor="#172B3A"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Verified reports and assigned work."
                android:textColor="#667986"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/tasks_status_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_background"
                android:padding="6dp" />

            <TextView
                android:id="@+id/tasks_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No maintenance tasks match this filter."
                android:textColor="#667986"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tasks_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp" />
</LinearLayout>
