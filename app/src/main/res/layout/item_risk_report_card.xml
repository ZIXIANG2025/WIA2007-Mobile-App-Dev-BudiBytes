<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/risk_rank_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="14dp"
            android:textColor="#64748B"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:ignore="RtlSymmetry"
            tools:text="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/risk_item_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Faculty of Engineering, Block A" />

            <TextView
                android:id="@+id/risk_item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#667986"
                android:textSize="12sp"
                tools:text="Clogged · 2026-10-24, 16:12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Blocked drainage and high pedestrian exposure during expected rain."
                android:textColor="#667986"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/risk_item_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:textColor="#B43518"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="High risk" />

            <Button
                android:id="@+id/risk_btn_view_details"
                android:layout_width="90dp"
                android:layout_height="36dp"
                android:background="@drawable/secondary_button_background"
                android:text="View Details"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
