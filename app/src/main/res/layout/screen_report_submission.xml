<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context="com.um.rainguard.ui.report.ReportSubmissionActivity"
    tools:theme="@style/AppTheme">

    <!-- Header & Disclaimer -->
    <include
        android:id="@+id/workspace_header"
        layout="@layout/include_workspace_header" />

    <ScrollView
        android:id="@+id/page_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/page_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Report a drainage issue"
                android:textColor="#0F172A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <!-- Location -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Campus location"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/place_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/card_background"
                android:padding="6dp" />

            <!-- Category -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hazard category"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/category_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/card_background"
                android:padding="6dp" />

            <!-- Severity -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Observed severity"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/risk_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_background"
                android:padding="6dp" />

            <!-- Similar Active Report Box -->
            <LinearLayout
                android:id="@+id/active_report_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/warning_background"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/active_report_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Similar active report: RG-1042"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/active_report_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Faculty of Engineering, Block A · Clogged · In progress"
                    android:textColor="#451A03"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <Button
                    android:id="@+id/btn_confirm_existing"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/primary_button_background"
                    android:text="Confirm existing report"
                    android:textAllCaps="false"
                    android:textColor="@color/surface"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="6dp" />

                <Button
                    android:id="@+id/btn_continue_new"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/secondary_button_background"
                    android:text="Continue with new report"
                    android:textAllCaps="false"
                    android:textColor="#0F172A"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/description_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:autofillHints="none"
                android:background="@drawable/secondary_button_background"
                android:gravity="top|start"
                android:hint="Describe the blockage, water level and affected walkway..."
                android:inputType="textMultiLine"
                android:minLines="4"
                android:padding="12dp"
                android:textColor="#0F172A"
                android:textColorHint="#667986" />

            <!-- Photo Upload -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Report photo (optional)"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_choose_photo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/secondary_button_background"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="14dp"
                android:text="Choose File  No file chosen"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="13sp" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/btn_submit_report"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/primary_button_background"
                android:text="＋  Submit report"
                android:textAllCaps="false"
                android:textColor="@color/surface"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp" />
</LinearLayout>
