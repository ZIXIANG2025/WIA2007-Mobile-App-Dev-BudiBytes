<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top row: Dot + Location Title + Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/report_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text="●"
            android:textColor="#B45309"
            android:textSize="12sp"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:id="@+id/report_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Faculty of Engineering, Block A" />

        <TextView
            android:id="@+id/report_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="12sp"
            tools:text="2h ago" />
    </LinearLayout>

    <!-- Subtitle: category · tags · ID -->
    <TextView
        android:id="@+id/report_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#64748B"
        android:textSize="13sp"
        tools:text="Clogged drain · leaves · RG-1042" />

    <!-- Status pill + Confirmations count row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/report_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="#075985"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="In progress" />

        <TextView
            android:id="@+id/report_confirmed_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="#64748B"
            android:textSize="12sp"
            tools:text="👍 14 confirmed" />
    </LinearLayout>

    <!-- Action buttons: Still There & Cleared -->
    <LinearLayout
        android:id="@+id/report_action_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_still_there"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/secondary_button_background"
            android:text="👍 Still There (14)"
            android:textAllCaps="false"
            android:textColor="#1D4ED8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_cleared"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/secondary_button_background"
            android:text="✓ Cleared (0)"
            android:textAllCaps="false"
            android:textColor="#15803D"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
