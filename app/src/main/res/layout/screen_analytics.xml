<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context="com.um.rainguard.ui.admin.AnalyticsActivity"
    tools:theme="@style/AppTheme">

    <!-- Workspace Header & Disclaimer -->
    <include
        android:id="@+id/workspace_header"
        layout="@layout/include_workspace_header" />

    <ScrollView
        android:id="@+id/page_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/page_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analytics &amp; Activity"
                android:textColor="#172B3A"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sample report trends for the UM campus demo."
                android:textColor="#667986"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="Report status breakdown"
                android:textColor="#172B3A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Breakdown Rows -->
            <LinearLayout
                android:id="@+id/analytics_status_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Recurring hotspots · historical sample"
                android:textColor="#172B3A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Hotspot 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Faculty of Engineering, Block A"
                    android:textColor="#172B3A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Blockage recurrence factor: 95% · sample historical estimate"
                    android:textColor="#667986"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Hotspot 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KK8 walkway to bus stop"
                    android:textColor="#172B3A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Blockage recurrence factor: 70% · sample historical estimate"
                    android:textColor="#667986"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Hotspot 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Main Library back entrance"
                    android:textColor="#172B3A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Blockage recurrence factor: 40% · sample historical estimate"
                    android:textColor="#667986"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/analytics_tasks_summary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Maintenance completed: 1 / 1 tasks"
                android:textColor="#172B3A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Recent activity"
                android:textColor="#172B3A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Activity Container -->
            <LinearLayout
                android:id="@+id/analytics_activity_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp" />
</LinearLayout>
